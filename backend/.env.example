# AI Content Pipeline - API Keys Configuration
# Copy this file to .env and add your actual API keys

# OpenAI (for GPT-4 and DALL-E 3 image generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude (optional, for Claude 3.5 Sonnet)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional, for Gemini 1.5 Pro)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER_DEFAULT=gemini

# DeepSeek (optional, for DeepSeek-chat)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=...

# Notes:
# - You only need ONE of these keys to get started
# - OpenAI is recommended for best quality + image generation
# - Remove or comment out keys you don't have
# - Never commit the .env file to version control
