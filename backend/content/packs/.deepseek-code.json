{
  "approval_mode": "prompt",
  "auto_approve": false,
  "approve_reads": false,
  "readonly": false,
  "denylist": [],
  "default_model": "deepseek-chat",
  "base_url": "https://api.deepseek.com",
  "max_messages": 50,
  "max_context_tokens": 64000,
  "request_timeout": 60,
  "max_retries": 3,
  "stream_word_delay_ms": 0,
  "show_timestamps": false,
  "show_separator": false,
  "indent_assistant": true,
  "assistant_indent": "  ",
  "show_token_usage": true,
  "show_thinking_time": false,
  "theme": "github",
  "custom_theme": null,
  "mode": "standard",
  "enable_semantic_search": false,
  "enable_workspace_memory": false,
  "log_path": null,
  "log_level": "INFO",
  "enable_telemetry": false,
  "max_file_size_bytes": 10485760,
  "shell_timeout": 30,
  "backup_count": 10,
  "system_prompt": null,
  "system_prompt_file": null,
  "append_system_prompt": null,
  "load_context_files": true
}